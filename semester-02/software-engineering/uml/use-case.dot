digraph use_case {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", nodesep=.4, ranksep=.8];
  node [fontname="DejaVu Sans", fontsize=12, shape=ellipse, style=filled, fillcolor="#f4f7fb", color="#435d77"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#46586c"];
  student [label="«actor»\nСтудент", shape=plaintext, style=""];
  editor [label="«actor»\nРедактор расписания", shape=plaintext, style=""];
  subgraph cluster_system {
    label="Система расписания";
    style=rounded; color="#8293a5";
    login [label="Войти"];
    view [label="Просмотреть\nрасписание"];
    day [label="Выбрать день"];
    logout [label="Выйти"];
    group [label="Выбрать группу"];
    add [label="Добавить занятие"];
    edit [label="Изменить занятие"];
    validate [label="Проверить конфликт"];
    del [label="Удалить занятие"];
    confirm [label="Подтвердить удаление"];
    {rank=same; login; view; day; logout; group; add; edit; del;}
    add -> validate [style=dashed, label="«include»"];
    edit -> validate [style=dashed, label="«include»"];
    del -> confirm [style=dashed, label="«include»"];
  }
  student -> {login view day logout} [dir=none];
  editor -> {login view day logout group add edit del} [dir=none];
}
